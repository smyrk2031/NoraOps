{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "NoraOps: アプリを実行 (F5)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/nora/packages/main.py",
      "cwd": "${workspaceFolder}/nora/packages",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "NoraOps: 現在のファイル (F5)",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${fileDirname}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
