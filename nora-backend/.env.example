# =============================================================================
# NoraOps nora-backend 環境変数（サンプル）
#
# 【初めての方】
#   1. このファイルを .env にコピーする
#   2. 「[必須]」セクションの GITEA_TOKEN などを埋める
#   3. ローカル開発なら DB は SQLite のまま（変更不要）
#   4. python -m uvicorn app.main:app --reload で起動
#
# 詳細ドキュメント:
#   ../NoraOps/認証モードとGitea運用.md
#   ../NoraOps/IIS-ARR配備.md
#
# 記法:
#   空欄 = 未設定（多くは既定値が使われる）
#   0 / 1 = 無効 / 有効（bool）
# =============================================================================


# =============================================================================
# [必須] サーバー基本
# =============================================================================

# 実行環境のラベル（ログ・表示用）。dev / staging / prod など任意の文字列
SOFTRAIL_ENV=dev

# バックエンドが待ち受ける IP。ローカル開発は 127.0.0.1 のまま
# IIS/ARR の裏では 127.0.0.1、外向きは IIS が担当する想定
SOFTRAIL_HOST=127.0.0.1

# バックエンドの待ち受けポート。ローカル直起動時は 8000 が一般的
SOFTRAIL_PORT=8000

# ログの詳細度: DEBUG / INFO / WARNING / ERROR
SOFTRAIL_LOG_LEVEL=INFO


# =============================================================================
# [必須] Gitea 接続
# NoraOps は Gitea を git サーバー兼ユーザ DB として使います
# =============================================================================

# Gitea のベース URL（ブラウザで開けるアドレス）
# 例: http://127.0.0.1:3000  /  https://gitea.corp.example.com
# ※ 存在しないホスト名を入れると API が 500 になります
GITEA_BASE_URL=http://127.0.0.1:3000

# サイト管理者の Personal Access Token（拡張には渡しません）
#
# 何に使うか:
#   - ユーザ登録時の Gitea アカウント自動作成
#   - 各ユーザ用 Gitea PAT の発行（サーバーが代行）
#   - Runner カタログ取得、topic 付与、artifact ビルド時の clone
#   - open モード開発時のフォールバック push
#
# 本番（email_token）では Creator の git push は「各ユーザの PAT」を使います。
# この GITEA_TOKEN はあくまで管理者用です。
#
# Gitea 1.19+ の scoped PAT 推奨スコープ:
#   write:user   … ユーザ作成・他ユーザ PAT 発行（必須）
#   write:repository … topic 付与・push 等
#   read:user    … GITEA_LIST_MODE=instance 時のカタログ取得
GITEA_TOKEN=


# =============================================================================
# [必須] データベース
#
# NoraOps バックエンド専用 DB です。Gitea が使う DB とは別で構いません。
# （同じ PostgreSQL サーバー上に DB を分けて作るのは OK）
# =============================================================================

# --- どちらを使うか ---
#
# 優先順位:
#   1. SOFTRAIL_DB_URL が空でない → その URL に接続（backend 設定はほぼ無視）
#   2. SOFTRAIL_DB_URL が空 → SOFTRAIL_DB_BACKEND に従う
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │ パターン A: SQLite（ローカル開発向け・既定）                              │
# │   - ファイル 1 つで完結。セットアップ不要                                  │
# │   - 複数プロセス同時書き込みには不向き                                    │
# └─────────────────────────────────────────────────────────────────────────┘
SOFTRAIL_DB_BACKEND=sqlite
# SQLite ファイルのパス（相対パスは nora-backend/ からの相対）
SOFTRAIL_SQLITE_PATH=./data/softrail.db
# PostgreSQL を使わないときは空のまま
SOFTRAIL_DB_URL=

# ┌─────────────────────────────────────────────────────────────────────────┐
# │ パターン B: PostgreSQL（本番・複数ワーカー向け）                          │
# │   使うときは A の 3 行をコメントアウトし、以下を有効化                    │
# └─────────────────────────────────────────────────────────────────────────┘
# SOFTRAIL_DB_BACKEND=postgres
#
# 接続 URL（SQLAlchemy 形式）。例:
#   postgresql+psycopg://ユーザ名:パスワード@ホスト:ポート/データベース名
#
# 具体例:
#   postgresql+psycopg://noraops:SecretPass@127.0.0.1:5432/noraops
#
# 意味の分解:
#   postgresql+psycopg://  … Python ドライバ psycopg を使う指定（このまま）
#   noraops                … PostgreSQL のログインユーザ名
#   SecretPass             … そのパスワード
#   127.0.0.1:5432         … PostgreSQL サーバーのアドレスとポート
#   noraops                … 接続先データベース名（事前に CREATE DATABASE が必要）
#
# ※ SOFTRAIL_DB_URL を設定すると SOFTRAIL_DB_BACKEND より URL が優先されます
# SOFTRAIL_DB_URL=postgresql+psycopg://noraops:change-me@127.0.0.1:5432/noraops
#
# URL を空のまま backend=postgres にすると、開発用フォールバック
#   127.0.0.1:5432/gitea（ユーザ gitea / パスワード gitea）に接続します
# 本番では必ず SOFTRAIL_DB_URL を明示してください。
#
# バックアップ/復元に pg_dump / psql が PATH に必要です


# =============================================================================
# [本番移行時] 認証モード
#
# NORAOPS_AUTH_MODE は 1 つだけ選びます（同時併用不可）
#
#   open          … 開発用。誰でも push 可能。本番では使わない
#   email_token   … 本番推奨。メール登録 → URL 有効化 → NoraAccessToken
#   windows_trust … レガシー（IIS Windows 認証 + デバイス登録）
#   email_otp     … レガシー（メール 6 桁 OTP ログイン）
# =============================================================================

# ▼ 開発（既定）
NORAOPS_AUTH_MODE=open

# ▼ 本番（email_token）に切り替えるとき: 上をコメントアウトし以下を有効化
# NORAOPS_AUTH_MODE=email_token
#
# ユーザがメールの URL を開いたときに生成されるリンクのベース URL
# 例: https://intranet.corp.example.com/NoraOps（末尾スラッシュなし）
# IIS サブパス配備時は NORAOPS_ROOT_PATH と揃える
# NORAOPS_PUBLIC_BASE_URL=https://intranet/NoraOps
#
# 仮登録メールのリンク有効時間（時間）
# NORAOPS_PENDING_REGISTRATION_HOURS=12
#
# NoraAccessToken の有効日数。0 = 無期限
# NORAOPS_ACCESS_TOKEN_DAYS=0
#
# 登録を許可するメールドメイン（カンマ区切り）。空 = 制限なし
# NORAOPS_ALLOWED_EMAIL_DOMAINS=corp.example.com,example.co.jp
#
# --- メール送信（email_token 本番では必須）---
# プロバイダ: smtp または http
# NORAOPS_MAIL_PROVIDER=smtp
# NORAOPS_SMTP_HOST=smtp.corp.example.com
# NORAOPS_SMTP_PORT=587
# NORAOPS_SMTP_USER=noraops-smtp-user
# NORAOPS_SMTP_PASSWORD=
# NORAOPS_SMTP_FROM=noraops@corp.example.com
# NORAOPS_SMTP_USE_TLS=1
#
# 自社メール API を使う場合:
# NORAOPS_MAIL_PROVIDER=http
# NORAOPS_MAIL_HTTP_URL=https://mail-api.corp.example.com/send_mail
# NORAOPS_MAIL_HTTP_API_KEY=

# ▼ IIS レガシー本番（windows_trust）
# NORAOPS_AUTH_MODE=windows_trust
# IIS が付与する Windows ログインヘッダ名
# NORAOPS_TRUSTED_USER_HEADER=X-Remote-User
# メール自動紐づけ用ヘッダ（任意）
# NORAOPS_TRUSTED_EMAIL_HEADER=X-Remote-Email

# ▼ メール OTP 本番（email_otp）
# NORAOPS_AUTH_MODE=email_otp
# （SMTP 設定は email_token と同様）
# NORAOPS_OTP_TTL_MINUTES=10
# NORAOPS_SESSION_IDLE_DAYS=7
# NORAOPS_SESSION_ABSOLUTE_DAYS=30

# --- 認証共通 ---

# 1 = 初回アクセス時に Gitea ユーザを自動作成（open / email_otp 向け）
# email_token ではメール有効化後に作成するため、実質オフ相当の動きになります
NORAOPS_GITEA_AUTO_PROVISION=1

# Gitea ユーザに付与するメールのドメイン（実メールがない場合の仮アドレス用）
# 例: noreply.local → login@noreply.local
NORAOPS_GITEA_EMAIL_DOMAIN=noreply.example.local

# windows_trust 専用: 1 = メール有効化完了まで Gitea を作らない（推奨）
NORAOPS_REQUIRE_EMAIL_ACTIVATION=1

# windows_trust 専用: 有効化メールリンクの有効時間（時間）
NORAOPS_ACTIVATION_TTL_HOURS=24

# メール送信方式（開発では smtp のままでも可。ホスト未設定なら送信エラー）
NORAOPS_MAIL_PROVIDER=smtp

# 本番必須: 各ユーザの Gitea PAT を DB に暗号化保存するための秘密鍵
# 長いランダム文字列に必ず変更してください（漏洩すると PAT が復号される恐れ）
NORAOPS_USER_TOKEN_SECRET=change-me-in-production


# =============================================================================
# [通常は既定のまま] Gitea 一覧・保存・Runner
# =============================================================================

# Runner カタログでリポジトリをどう列挙するか
#   instance  … インスタンス横断検索（管理者トークン推奨・既定）
#   scoped    … GITEA_ORGS で指定した Organization のみ
#   all_orgs  … 管理者 API で全 Organization を列挙
GITEA_LIST_MODE=instance

# GITEA_LIST_MODE=scoped のとき、対象 Organization（カンマ区切り）
# 例: GITEA_ORGS=my-team,dev-team
GITEA_ORGS=

# Gitea API の 1 ページあたり件数
GITEA_DEFAULT_PER_PAGE=50

# git push 用セッションの有効時間（分）。拡張が zip をアップロードする猶予
NORAOPS_PUSH_SESSION_TTL_MINUTES=15

# push セッションで受け付ける zip の最大サイズ（MB）
NORAOPS_PUSH_MAX_BUNDLE_MB=100

# 「保存」機能の zip 最大サイズ（MB）
NORAOPS_SAVE_MAX_ZIP_MB=50

# 通常保存（下書き）の push 先ブランチ。force push し履歴は残さない
NORAOPS_SAVE_DRAFT_BRANCH=noraops-draft

# 公開リリースの正式ブランチ。force push しない
NORAOPS_SAVE_PUBLISH_BRANCH=main

# Runner artifact（ビルド成果物）の保存ディレクトリ
NORAOPS_ARTIFACTS_DIR=./data/noraops/artifacts

# この topic が付いた Gitea リポだけ Runner カタログに公開される
NORAOPS_PUBLISHED_TOPIC=nora-published

# VS Code 拡張（.vsix）のダウンロード URL（相対パス可）
# 例: /static/noraops4code.vsix → バックエンドの static から配信
SOFTRAIL_CLIENT_DOWNLOAD_URL=/static/noraops4code.vsix

# uv / PortableGit 等のツール一覧 manifest.json のパス
SOFTRAIL_TOOLS_MANIFEST_PATH=./data/tools/windows-x64/manifest.json

# 1 = 起動時に data/ が空なら同梱の bootstrap_data から初期ファイルを復元
NORAOPS_DATA_BOOTSTRAP=1


# =============================================================================
# [変更時のみ] IIS / リバースプロキシ（サブパス配備）
# ローカルで 127.0.0.1:8000 直起動なら両方空で OK
# =============================================================================

# URL のサブパス。例: /NoraOps → https://server/NoraOps/admin
# ローカル直起動では空
NORAOPS_ROOT_PATH=

# 外向きの公開 URL（メール内リンク・ポータル表示用）
# 未設定時はリクエストの Host ヘッダ + NORAOPS_ROOT_PATH から推定
# 拡張の noraops.server.baseUrl も同じオリジンに揃える（末尾スラッシュなし）
# NORAOPS_PUBLIC_BASE_URL=http://intranet/NoraOps


# =============================================================================
# [オプション] 管理画面の保護
# 両方を設定したときだけ /admin と /api/admin に Basic 認証がかかります
# =============================================================================

# NORAOPS_ADMIN_BASIC_USER=admin
# NORAOPS_ADMIN_BASIC_PASSWORD=change-me-strong-password


# =============================================================================
# [オプション] 管理画面 — 手動ユーザ（メールなし運用用）
# 0=無効（本番デフォルト） / 1= /admin/manual-users を有効化
# 無効化しても既存の手動ユーザは DB / Gitea に残ります（ソフト無効化）
# =============================================================================

# NORAOPS_ADMIN_MANUAL_PROVISION=0


# =============================================================================
# [本番サーバー] 自動バックアップ（NoraOps バックエンド + Gitea 資産）
#
# 目的:
#   サーバー故障・ディスク障害時に NoraOps と Gitea を丸ごと復旧するための ZIP 世代管理。
#   拡張の「クラウドにバックアップ」（ユーザのアプリを Gitea リポに送る）とは別物です。
#
# 何が ZIP に入るか（既定）:
#   backend.db          … バックエンド DB（ユーザ・認証・app レジストリ等）
#   backend.noraops_core … checks / MCP / prompts / concierge 等（data/noraops/）
#   gitea.config        … Gitea の app.ini
#   gitea.db            … Gitea の DB（SQLite コピー or Postgres の pg_dump）
#   gitea.repos         … リポジトリ実体（repository.ROOT 以下）
#
# 含まれないもの（別途保管が必要）:
#   .env 自体、IIS 設定、Windows サービス登録、SSL 証明書
#   artifacts / tools（下記 INCLUDE_* が 0 のとき）
#
# 前提（必ず確認）:
#   1. 管理画面 /admin/settings で gitea_exe_path（gitea.exe のフルパス）を登録
#      → 未登録だと Gitea 分がバックアップに入らず警告になります
#   2. Postgres 利用時は pg_dump / psql がサーバーの PATH にあること
#   3. 初回セットアップ後に /admin/backup で「今すぐバックアップ」を実行し ZIP を確認
#   4. 切り戻しは本番前に /admin/backup でテスト復元（pre-restore 世代が自動作成されます）
#
# 運用の詳細: リポジトリ内 NoraOps/バックアップと復元.md
# 管理 UI:     {ポータルURL}/admin/backup
# =============================================================================

# 1 = 定期バックアップを有効化（uvicorn 起動時にスケジューラも動く）
# ローカル開発だけなら 0 にしてもよい（手動実行は管理画面から可能）
NORAOPS_BACKUP_ENABLED=1

# 前回の成功から何時間空けて次を実行するか（既定 24 = 1日1回）
NORAOPS_BACKUP_INTERVAL_HOURS=24

# ローカル・リモート双方で保持する ZIP の世代数（超えた古い世代は自動削除）
NORAOPS_BACKUP_RETENTION=3

# バックアップ ZIP の保存先（サーバー上のディレクトリ。相対パスは nora-backend 起動ディレクトリ基準）
# 例: ./data/backups  →  noraops-backup-YYYYMMDD-HHMMSS-xxxxxx.zip が並ぶ
NORAOPS_BACKUP_LOCAL_DIR=./data/backups

# 1 = Runner 成果物（data/artifacts 等）も ZIP に含める（容量が大きくなる）
NORAOPS_BACKUP_INCLUDE_ARTIFACTS=0

# 1 = 配布ツール（uv.exe 等）も ZIP に含める（容量が大きくなる）
NORAOPS_BACKUP_INCLUDE_TOOLS=0

# 設定すると ZIP を AES 暗号化（持ち出し・保管時の保護用）
# 復元時も同じパスワードが必要。紛失すると ZIP を開けません
# NORAOPS_BACKUP_ZIP_PASSWORD=your-backup-zip-secret

# 【災害復旧で重要】バックアップ ZIP のリモートコピー先（任意だが本番では強く推奨）
# サーバーごと壊れると LOCAL_DIR だけでは復旧できないため、別ホスト・NAS・ファイルサーバへ
# Windows の UNC 例（バックスラッシュは .env では \\ とエスケープ）:
# NORAOPS_BACKUP_REMOTE_DIR=\\\\fileserver\\share\\noraops-backups
# コピー成功時も RETENTION 世代管理の対象になります（ローカルと同数を維持）

# 管理画面から個別に上書き可能な項目（app_config に保存・/admin/backup の設定フォーム）:
#   backup_enabled, backup_interval_hours, backup_retention,
#   backup_local_dir, backup_remote_dir, backup_include_artifacts, backup_include_tools
# .env の値が初期値。運用中は管理画面の変更が DB 側設定として優先される場合があります


# =============================================================================
# [オプション] 開発・デバッグ
# =============================================================================

# 1 = topic がなくても Runner カタログに全リポ表示（本番は 0）
NORAOPS_CATALOG_DEV_SHOW_ALL=0

# 1 = 拡張 API が Gitea 管理者 PAT を返す（セキュリティ上非推奨・デバッグのみ）
# NORAOPS_CLIENT_EXPOSE_GITEA_TOKEN=0

# ポータル/help で参照する Markdown のルートディレクトリ
# 未設定時はリポジトリの ../NoraOps/ を自動参照
# NORAOPS_DOCS_DIR=F:/path/to/NoraOps


# =============================================================================
# [オプション] PyPI 社内ミラー
# 未設定時は拡張がインターネットの PyPI に直接アクセスします
# =============================================================================

# 社内 PyPI simple API の URL（末尾 /simple/ 推奨）
# NORAOPS_PYPI_INDEX_URL=https://intranet/NoraOps/pypi/simple/

# 1 = 社内ミラーに無いパッケージは PyPI へフォールバック
# NORAOPS_PYPI_FALLBACK_ENABLED=1

# ミラー用ホイール等の保存ディレクトリ
# NORAOPS_PYPI_MIRROR_DIR=./data/noraops/packages/mirror
# NORAOPS_PYPI_MIRROR_ARCHIVE_DIR=./data/noraops/packages/mirror-archive


# =============================================================================
# [オプション] リポジトリ監査
# 拡張のセキュリティチェックをサーバー側 Node CLI で再実行
# =============================================================================

# 1 = 監査機能全体を有効化
NORAOPS_REPO_AUDIT_ENABLED=1

# 1 = 保存時に監査を実行
NORAOPS_REPO_AUDIT_ON_SAVE=1

# 1 = 毎晩の定期監査を実行
NORAOPS_REPO_AUDIT_NIGHTLY=1

# 定期監査の実行時刻（24 時制）
NORAOPS_REPO_AUDIT_HOUR=23
NORAOPS_REPO_AUDIT_MINUTE=30

# VS Code 拡張ソースのパス（監査 CLI 用）
# 優先: この値 > vendor/vscode-extension > extensions/ > ../vscode-extension
# NORAOPS_EXTENSION_DIR=./vendor/vscode-extension

# Node.js の場所（監査 CLI 実行用。PATH 不要にするため同梱推奨）
# 優先順:
#   1. NORAOPS_NODE_EXE … node.exe のフルパス
#   2. data/tools/node/<NORAOPS_NODE_VERSION>/node.exe
#   3. PATH の node（開発のみ）
NORAOPS_NODE_VERSION=22.12.0
# NORAOPS_NODE_EXE=F:/path/to/node.exe
# NORAOPS_NODE_DIR=./data/tools/node/22.12.0


# =============================================================================
# [オプション] AI 踏み台（Copilot BYOK）
# 使わない場合は NORAOPS_AI_ENABLED=0 のまま。以下は触らなくてよい
# =============================================================================

# 1 = Azure OpenAI 経由の AI チャットを有効化
NORAOPS_AI_ENABLED=0

# Azure OpenAI のエンドポイント（例: https://xxx.openai.azure.com/）
# AZURE_OPENAI_ENDPOINT=

# Azure OpenAI の API キー
# AZURE_OPENAI_API_KEY=

# デプロイメント名（Azure ポータルで作成したモデル名）
# AZURE_OPENAI_DEPLOYMENT=

# API バージョン
# AZURE_OPENAI_API_VERSION=2024-02-15-preview

# 1 ユーザあたりの 1 日トークン上限。0 = 無制限
# NORAOPS_AI_DAILY_TOKEN_LIMIT=0

# 管理画面の円換算レート（1K トークンあたり円・請求に合わせて調整）
# NORAOPS_AI_JPY_PER_1K_INPUT=0.5
# NORAOPS_AI_JPY_PER_1K_OUTPUT=1.5

# 1 = 組織ゲートウェイ経由のみ許可（社内ポリシー向け）
# NORAOPS_AI_REQUIRE_ORG_GATEWAY=1

# 1 = VS Code Copilot 連携を許可
# NORAOPS_COPILOT_ENABLED=1

# 1 = Continue 拡張連携を許可
# NORAOPS_CONTINUE_ENABLED=1

# Copilot / 拡張の最低バージョン要件
# NORAOPS_COPILOT_MIN_HOST_VERSION=1.122.0
# NORAOPS_CLIENT_MIN_HOST_VERSION=1.88.0


# =============================================================================
# [オプション] ネットワーク・プロキシ
# =============================================================================

# 0 = 環境変数 HTTP_PROXY / HTTPS_PROXY を使わない（社内 Gitea 直結向け・既定）
# 1 = httpx がシステム/環境のプロキシ設定を参照（外向きのみプロキシ必須の組織）
NORAOPS_HTTP_TRUST_ENV=0
