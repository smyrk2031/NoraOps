# =============================================================================
# NoraOps nora-backend 環境変数
#
# 使い方: このファイルを .env にコピーし、「[必須]」を埋める。
# その他は既定のままで動く。変更が必要なときだけ該当セクションを開く。
#
# 認証の詳細: ../NoraOps/認証モードとGitea運用.md
# IIS 配備:    ../NoraOps/IIS-ARR配備.md
# =============================================================================


# =============================================================================
# [必須] 初回セットアップ
# =============================================================================

# --- サーバー ---
SOFTRAIL_ENV=dev
SOFTRAIL_HOST=127.0.0.1
SOFTRAIL_PORT=8000
SOFTRAIL_LOG_LEVEL=INFO

# --- Gitea（必須）---
# 実際に届く URL を指定（プレースホルダ hostname は DNS エラーで 500 になる）
GITEA_BASE_URL=http://127.0.0.1:3000
# サイト管理者 PAT（拡張には渡さない）。主な用途:
#   - Gitea ユーザ自動作成・各ユーザ用 PAT の発行（プロビジョン）
#   - Runner カタログ / 管理画面のリポ一覧・topic 付与・artifact ビルド時の clone
#   - open モード開発時のフォールバック（認証ユーザなし時の API / git push）
# 本番（email_token 等）の Creator 保存 git push は各ユーザ PAT（DB 暗号化保存）を使用。
# 推奨: Gitea サイト管理者アカウントの scoped PAT（Gitea 1.19+）
#   user: 読み取り+書き込み（write:user — ユーザ作成・他ユーザ PAT 発行に必要）
#   repository: 読み取り+書き込み（topic 付与・artifact・open 時 push）
#   read:user（GITEA_LIST_MODE=instance 時の /user/repos 用。無いとカタログが空になることがある）
GITEA_TOKEN=

# --- データベース ---
# 優先順: SOFTRAIL_DB_URL が設定されていればそれを使用（以下は無視）
#
# ▼ パターン A: SQLite（既定・ローカル開発向け）
SOFTRAIL_DB_BACKEND=sqlite
SOFTRAIL_SQLITE_PATH=./data/softrail.db
SOFTRAIL_DB_URL=
#
# ▼ パターン B: PostgreSQL（本番・複数プロセス向け）
# SOFTRAIL_DB_BACKEND=postgres
# SOFTRAIL_DB_URL=postgresql+psycopg://user:pass@127.0.0.1:5432/noraops
# ※ バックアップ/復元には pg_dump / psql が PATH に必要（backend/softrail.sql）
# ※ DB_URL 未設定かつ backend=postgres のときは 127.0.0.1:5432/gitea（gitea:gitea）に接続
#
# Gitea と同じ DB を共有する必要はない（NoraOps 用に別 DB を推奨）


# =============================================================================
# [本番移行時] 認証モード
# NORAOPS_AUTH_MODE は環境ごとに 1 つだけ選ぶ（同時併用不可）
#
#   open           … ローカル開発。誰でも push セッション取得可
#   email_token    … 本番推奨。メール登録 → リンク有効化 → NoraAccessToken
#   windows_trust  … レガシー（IIS + デバイス登録）
#   email_otp      … レガシー（メール OTP ログイン）
# =============================================================================

# ▼ 開発（既定）
NORAOPS_AUTH_MODE=open

# ▼ 本番（推奨）に切り替えるとき: 上をコメントアウトし、以下を有効化
# NORAOPS_AUTH_MODE=email_token
# NORAOPS_PUBLIC_BASE_URL=https://intranet/NoraOps
# NORAOPS_PENDING_REGISTRATION_HOURS=12
# NORAOPS_ACCESS_TOKEN_DAYS=0
# NORAOPS_ALLOWED_EMAIL_DOMAINS=corp.example.com
#
# メール送信（register-email / 有効化リンク / トークン再発行で必須）
# NORAOPS_MAIL_PROVIDER=smtp
# NORAOPS_SMTP_HOST=smtp.corp.example.com
# NORAOPS_SMTP_PORT=587
# NORAOPS_SMTP_USER=
# NORAOPS_SMTP_PASSWORD=
# NORAOPS_SMTP_FROM=noraops@corp.example.com
# NORAOPS_SMTP_USE_TLS=1
# または自社メール API（http / https どちらでも可）:
# NORAOPS_MAIL_PROVIDER=http
# NORAOPS_MAIL_HTTP_URL=https://mail-api.corp.example.com/send_mail
# NORAOPS_MAIL_HTTP_API_KEY=

# ▼ IIS レガシー本番
# NORAOPS_AUTH_MODE=windows_trust
# NORAOPS_TRUSTED_USER_HEADER=X-Remote-User
# NORAOPS_TRUSTED_EMAIL_HEADER=X-Remote-Email

# ▼ Windows なし本番（メール OTP）に切り替えるとき
# NORAOPS_AUTH_MODE=email_otp
# NORAOPS_SMTP_HOST=smtp.corp.example.com
# NORAOPS_SMTP_PORT=587
# NORAOPS_SMTP_USER=
# NORAOPS_SMTP_PASSWORD=
# NORAOPS_SMTP_FROM=noraops@corp.example.com
# NORAOPS_SMTP_USE_TLS=1
# NORAOPS_OTP_TTL_MINUTES=10
# NORAOPS_SESSION_IDLE_DAYS=7
# NORAOPS_SESSION_ABSOLUTE_DAYS=30

# 認証共通（open 以外の本番では要確認）
NORAOPS_GITEA_AUTO_PROVISION=1
NORAOPS_GITEA_EMAIL_DOMAIN=noreply.example.local
# windows_trust レガシー用（email_token では未使用）
NORAOPS_REQUIRE_EMAIL_ACTIVATION=1
NORAOPS_ACTIVATION_TTL_HOURS=24
# メール送信プロバイダ（email_token 本番では上記 SMTP/HTTP を有効化）
NORAOPS_MAIL_PROVIDER=smtp
# NORAOPS_MAIL_PROVIDER=http
# NORAOPS_MAIL_HTTP_URL=https://mail-api.corp.example.com/send_mail
# NORAOPS_MAIL_HTTP_API_KEY=
# 本番必須: ユーザ PAT 暗号化用（長いランダム文字列に変更）
NORAOPS_USER_TOKEN_SECRET=change-me-in-production


# =============================================================================
# [通常は既定のまま] Gitea 連携・保存・Runner
# =============================================================================

GITEA_LIST_MODE=instance
GITEA_ORGS=
GITEA_DEFAULT_PER_PAGE=50

NORAOPS_PUSH_SESSION_TTL_MINUTES=15
NORAOPS_PUSH_MAX_BUNDLE_MB=100
NORAOPS_SAVE_MAX_ZIP_MB=50
# 通常保存の下書きブランチ（force push・履歴は残さない）
NORAOPS_SAVE_DRAFT_BRANCH=noraops-draft
# 公開リリースの正式ブランチ（履歴を積む・force しない）
NORAOPS_SAVE_PUBLISH_BRANCH=main
NORAOPS_ARTIFACTS_DIR=./data/noraops/artifacts

# Runner 公開: リポに topic を付与するとカタログに載る
NORAOPS_PUBLISHED_TOPIC=nora-published

SOFTRAIL_CLIENT_DOWNLOAD_URL=/static/noraops4code.vsix
SOFTRAIL_TOOLS_MANIFEST_PATH=./data/tools/windows-x64/manifest.json
NORAOPS_DATA_BOOTSTRAP=1


# =============================================================================
# [変更時のみ] IIS / リバースプロキシ（サブパス配備）
# ローカル直起動 (127.0.0.1:8000) なら空のまま
# =============================================================================

NORAOPS_ROOT_PATH=
# NORAOPS_PUBLIC_BASE_URL=http://intranet/NoraOps
# 拡張 noraops.server.baseUrl も同じオリジン（末尾スラッシュなし）


# =============================================================================
# [本番サーバー] 自動バックアップ
# ローカル開発では 0 にしてもよい
# =============================================================================

NORAOPS_BACKUP_ENABLED=1
NORAOPS_BACKUP_INTERVAL_HOURS=24
NORAOPS_BACKUP_RETENTION=3
NORAOPS_BACKUP_LOCAL_DIR=./data/backups
NORAOPS_BACKUP_INCLUDE_ARTIFACTS=0
NORAOPS_BACKUP_INCLUDE_TOOLS=0
# 設定するとバックアップ ZIP を AES 暗号化（7-Zip 等でも開ける形式）
# NORAOPS_BACKUP_ZIP_PASSWORD=your-backup-zip-secret
# NORAOPS_BACKUP_REMOTE_DIR=\\\\fileserver\\share\\noraops-backups


# =============================================================================
# [オプション] 開発・デバッグ用
# =============================================================================

# 1 = topic なしでも Runner に全リポ表示（本番では 0 のまま）
NORAOPS_CATALOG_DEV_SHOW_ALL=0

# 1 = 拡張へ Gitea PAT を返す（非推奨。デバッグのみ）
# NORAOPS_CLIENT_EXPOSE_GITEA_TOKEN=0

# ヘルプ MD の場所（未設定時は ../NoraOps を自動参照）
# NORAOPS_DOCS_DIR=


# =============================================================================
# [オプション] PyPI 社内ミラー
# 未設定時は拡張が PyPI 直アクセス
# =============================================================================

# NORAOPS_PYPI_INDEX_URL=https://intranet/NoraOps/pypi/simple/
# NORAOPS_PYPI_FALLBACK_ENABLED=1
# NORAOPS_PYPI_MIRROR_DIR=./data/noraops/packages/mirror
# NORAOPS_PYPI_MIRROR_ARCHIVE_DIR=./data/noraops/packages/mirror-archive


# =============================================================================
# [オプション] リポジトリ監査（拡張 checkRunner を Node CLI 経由で実行）
# =============================================================================

NORAOPS_REPO_AUDIT_ENABLED=1
NORAOPS_REPO_AUDIT_ON_SAVE=1
NORAOPS_REPO_AUDIT_NIGHTLY=1
NORAOPS_REPO_AUDIT_HOUR=23
NORAOPS_REPO_AUDIT_MINUTE=30

# 拡張ソース（監査 CLI = checkRunner 同一エンジン）
# 優先: NORAOPS_EXTENSION_DIR > vendor/vscode-extension > extensions/vscode-extension > ../vscode-extension
# 本番配備例: ビルド時に拡張を vendor/ へコピーし NORAOPS_EXTENSION_DIR=./vendor/vscode-extension
# NORAOPS_EXTENSION_DIR=./vendor/vscode-extension

# Node.js（PATH 不要 — uv/PortableGit と同様にサーバー同梱を推奨）
# 1) NORAOPS_NODE_EXE で node.exe フルパス指定（最優先）
# 2) 未設定時 data/tools/node/<NORAOPS_NODE_VERSION>/node.exe（公式 win-x64 zip を展開）
# 3) 開発のみ PATH の node（本番では非推奨）
NORAOPS_NODE_VERSION=22.12.0
# NORAOPS_NODE_EXE=F:/path/to/node.exe
# NORAOPS_NODE_DIR=./data/tools/node/22.12.0


# =============================================================================
# [オプション] AI 踏み台（Copilot BYOK）
# 使わない場合は NORAOPS_AI_ENABLED=0 のまま。以下は触らなくてよい
# =============================================================================

NORAOPS_AI_ENABLED=0
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-02-15-preview
# NORAOPS_AI_DAILY_TOKEN_LIMIT=0
# NORAOPS_AI_JPY_PER_1K_INPUT=0.5
# NORAOPS_AI_JPY_PER_1K_OUTPUT=1.5
# NORAOPS_AI_REQUIRE_ORG_GATEWAY=1
# NORAOPS_COPILOT_ENABLED=1
# NORAOPS_CONTINUE_ENABLED=1
# NORAOPS_COPILOT_MIN_HOST_VERSION=1.122.0
# NORAOPS_CLIENT_MIN_HOST_VERSION=1.88.0


# =============================================================================
# [オプション] ネットワーク
# 社内 Gitea 直結では 0 のまま。外向きのみプロキシ必須の組織では 1
# =============================================================================

NORAOPS_HTTP_TRUST_ENV=0
