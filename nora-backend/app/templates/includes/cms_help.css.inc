    .cms-help { margin:12px 0 16px; border:1px solid rgba(148,163,184,0.22); border-radius:8px; background:rgba(15,23,42,0.45); }
    .cms-help-global { margin-top:0; border-color:rgba(34,211,238,0.25); }
    .cms-help > summary { cursor:pointer; padding:10px 14px; font-size:0.88rem; font-weight:600; color:#e2e8f0; list-style:none; }
    .cms-help > summary::-webkit-details-marker { display:none; }
    .cms-help > summary::before { content:"▸ "; color:var(--accent2); }
    .cms-help[open] > summary::before { content:"▾ "; }
    .cms-help-body { padding:0 14px 14px; font-size:0.84rem; line-height:1.65; color:var(--muted); }
    .cms-help-body p { margin:0 0 10px; }
    .cms-help-body p:last-child { margin-bottom:0; }
    .cms-help-table { width:100%; border-collapse:collapse; font-size:0.8rem; margin:8px 0; }
    .cms-help-table th, .cms-help-table td { padding:6px 8px; text-align:left; border-bottom:1px solid rgba(148,163,184,0.12); vertical-align:top; }
    .cms-help-table th { color:#cbd5e1; font-weight:600; white-space:nowrap; }
    .cms-help-warn { color:#fde68a; font-size:0.8rem; margin-top:8px; }
    .cms-help-ok { color:#86efac; font-size:0.8rem; }
    .cms-req { color:#fde047; font-size:0.72rem; font-weight:600; }
    .cms-opt { color:var(--muted); font-size:0.72rem; }
